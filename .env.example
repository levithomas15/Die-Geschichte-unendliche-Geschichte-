# Kopieren nach .env und ausfüllen. Ohne STRIPE_SECRET_KEY läuft die Seite im Demo-Modus.

# Stripe-Dashboard → Entwickler → API-Schlüssel (zum Testen sk_test_…, live sk_live_…)
STRIPE_SECRET_KEY=
# Stripe-Dashboard → Entwickler → Webhooks → Signatur-Geheimnis (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Öffentliche Adresse der Seite, z. B. https://unendliche-geschichte.de
BASE_URL=

# Passwort für /admin (Moderation). Leer = Adminbereich aus.
ADMIN_PASSWORD=

# Rabattcode für −30 %
DISCOUNT_CODE=1589

# Ordner für die Datenbank – muss beim Hoster dauerhaft gespeichert werden
DATA_DIR=./data
PORT=3000

# false nur, wenn die Seite OHNE Proxy/Load-Balancer direkt im Internet steht; eine Zahl = Anzahl der Proxys
TRUST_PROXY=true
